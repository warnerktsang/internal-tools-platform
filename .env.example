# Local development. `pnpm db:up` starts Postgres on 5433 with these credentials.
DATABASE_URL="postgresql://itp:itp@localhost:5433/itp?schema=public"

# That is the only variable the app reads. The principal-switcher cookie carries a seeded
# principal id and is deliberately unauthenticated; the identity seam refuses to
# authenticate as anything but a seeded human, and real SSO replaces that seam entirely.
