# Local development. `pnpm db:up` starts Postgres on 5433 with these credentials.
DATABASE_URL="postgresql://itp:itp@localhost:5433/itp?schema=public"

# Only needed for a hosted demo: guards /api/demo/reseed and /api/effects/sweep, which reset
# the shared database and drain orphaned outbox rows. Both routes refuse to run when neither
# this nor Vercel Cron's CRON_SECRET is set.
# ADMIN_TOKEN="pick-something-long"

# DATABASE_URL is the only variable the app itself reads. The principal-switcher cookie carries a seeded
# principal id and is deliberately unauthenticated; the identity seam refuses to
# authenticate as anything but a seeded human, and real SSO replaces that seam entirely.
